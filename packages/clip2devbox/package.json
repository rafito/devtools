{
  "name": "@devorama/clip2devbox",
  "version": "0.3.1",
  "description": "Envia arquivo ou print do clipboard (Windows) pra uma devbox via Tailscale/scp e troca o clipboard pelo caminho remoto com prefixo @, pronto pra colar no Claude Code/ttyd.",
  "type": "module",
  "bin": {
    "clip2devbox": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist", "assets", "README.md"],
  "os": ["win32"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafito/devtools.git",
    "directory": "packages/clip2devbox"
  },
  "bugs": {
    "url": "https://github.com/rafito/devtools/issues"
  },
  "homepage": "https://github.com/rafito/devtools/tree/main/packages/clip2devbox#readme",
  "keywords": [
    "clipboard",
    "screenshot",
    "tailscale",
    "scp",
    "devbox",
    "claude-code",
    "ttyd",
    "windows",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check ."
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
