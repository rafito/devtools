{
  "name": "@devorama/utils",
  "version": "0.2.0",
  "description": "Zero-dependency TypeScript utilities: Brazilian formatters & validators (CPF, CNPJ, CEP, phone), currency/date formatting, and typed array/object helpers. Works in Node.js and the browser.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafito/devtools.git",
    "directory": "packages/utils"
  },
  "bugs": {
    "url": "https://github.com/rafito/devtools/issues"
  },
  "homepage": "https://github.com/rafito/devtools/tree/main/packages/utils#readme",
  "author": "Rafael D'Arrigo (https://github.com/rafito)",
  "license": "MIT",
  "keywords": [
    "typescript",
    "utilities",
    "formatters",
    "validators",
    "cpf",
    "cnpj",
    "cep",
    "currency",
    "brazil",
    "zero-dependencies"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
