{
  "name": "@devorama/autosupport",
  "version": "0.5.0",
  "description": "Autonomous support pipeline for Node.js: chat, investigation, fix, and review tiers powered by Anthropic or OpenAI (via the Vercel AI SDK), with GitHub and Sentry webhooks. Bring your own Express, Drizzle, and pg-boss.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafito/devtools.git",
    "directory": "packages/autosupport"
  },
  "bugs": {
    "url": "https://github.com/rafito/devtools/issues"
  },
  "homepage": "https://github.com/rafito/devtools/tree/main/packages/autosupport#readme",
  "author": "Rafael D'Arrigo (https://github.com/rafito)",
  "license": "MIT",
  "keywords": [
    "claude",
    "anthropic",
    "openai",
    "ai-sdk",
    "support",
    "automation",
    "ai-agent",
    "github",
    "sentry",
    "express",
    "drizzle",
    "pg-boss"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.0",
    "@ai-sdk/openai": "^2.0.0",
    "@ai-sdk/provider": "^2.0.0",
    "ai": "^5.0.0"
  },
  "peerDependencies": {
    "@sentry/node": ">=10.0.0",
    "drizzle-orm": ">=0.45.0",
    "express": ">=5.0.0",
    "pg-boss": ">=12.0.0"
  },
  "devDependencies": {
    "@sentry/node": "^10.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "drizzle-orm": "^0.45.0",
    "express": "^5.0.0",
    "msw": "^2.14.6",
    "pg-boss": "^12.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
